boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1e-4 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls                       // 上下壁面 + 圆柱面统一 no-slip
    {
        type            noSlip;
    }
    frontAndBack                // 2D 空面
    {
        type            empty;
    }
}