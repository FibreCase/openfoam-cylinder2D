// ============================================================
//  圆柱绕流 2D 计算域
//  Re = 100, D = 1m
// ============================================================

// ---------- 参数定义 ----------
D   = 1;          // 圆柱直径
R   = D / 2;        // 圆柱半径

x0  = 5 * D;        // 圆心 x（距入口 5D）
y0  = 0;            // 圆心 y（域中央）

Lx  = 20 * D;       // 域总长
Ly  = 10 * D;       // 域总高

// 网格尺寸
lc_far = D * 0.1;   // 远场特征尺寸
lc_cyl = D * 0.025;  // 圆柱表面特征尺寸（精细）

// ---------- 矩形域四个角点 ----------
Point(1) = {0,   -Ly/2, 0, lc_far};   // 左下
Point(2) = {Lx,  -Ly/2, 0, lc_far};   // 右下
Point(3) = {Lx,   Ly/2, 0, lc_far};   // 右上
Point(4) = {0,    Ly/2, 0, lc_far};   // 左上

// ---------- 圆柱上的点（圆心 + 四个极点）----------
Point(5) = {x0,      y0,    0, lc_cyl};  // 圆心（不进入网格，只用于圆弧定义）
Point(6) = {x0 + R,  y0,    0, lc_cyl};  // 右极点 (0°)
Point(7) = {x0,      y0+R,  0, lc_cyl};  // 上极点 (90°)
Point(8) = {x0 - R,  y0,    0, lc_cyl};  // 左极点 (180°)
Point(9) = {x0,      y0-R,  0, lc_cyl};  // 下极点 (270°)

// ---------- 矩形边界线 ----------
Line(1) = {1, 2};   // 底边 (bottom)
Line(2) = {2, 3};   // 右边 (outlet)
Line(3) = {3, 4};   // 顶边 (top)
Line(4) = {4, 1};   // 左边 (inlet)

// ---------- 圆柱圆弧（逆时针，4段各90°）----------
Circle(5) = {6, 5, 7};   //  0° →  90°
Circle(6) = {7, 5, 8};   // 90° → 180°
Circle(7) = {8, 5, 9};   // 180°→ 270°
Circle(8) = {9, 5, 6};   // 270°→ 360°

// ---------- 定义曲面 ----------
// 外边界环（逆时针为正）
Curve Loop(1) = {1, 2, 3, 4};
// 圆柱环（逆时针，作为"孔"需要与外环方向一致，Gmsh自动处理）
Curve Loop(2) = {5, 6, 7, 8};

// 带孔平面：外环 - 圆柱孔
Plane Surface(1) = {1, 2};

// ---------- Z方向拉伸（生成一层体网格）----------
thickness = 0.1 * D;  // Z方向厚度，仅需一层

Extrude {0, 0, thickness} {
    Surface{1};
    Layers{1};      // Z方向只拉一层
    Recombine;      // 生成六面体而非四面体（更适合OpenFOAM 2D）
}

// ---------- 定义 Physical Groups（边界命名）----------
// 拉伸后的面编号：Gmsh 自动生成，需在 GUI 中确认
// 或用下面的方法：先不加 Physical，运行后在 GUI 查看面编号

Physical Surface("inlet")    = {33};   // 左侧入口面（拉伸产生）
Physical Surface("outlet")   = {25};   // 右侧出口面
Physical Surface("walls") = {37, 41, 45, 49, 21, 29};  // 上下边界 + 圆柱表面（6-9 的拉伸面）
Physical Surface("frontAndBack") = {1, 50};        // 前后两个 empty 面
Physical Volume("fluid")     = {1};